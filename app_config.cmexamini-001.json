{
  "mqtt": {
    "broker_url": "localhost",
    "broker_port": 1883,
    "subscribe_topic": "cmeresearch/cmexamini-001/base/odometry"
  },
  "topics": {
    "movement": "cmeresearch/cmexamini-001/mqtt/cmd_vel",
    "move_base_goal": "cmeresearch/cmexamini-001/amr_control/move_base_goal",
    "robot_state": "cmeresearch/cmexamini-001/robot_state",
    "robot_cmd": "cmeresearch/cmexamini-001/robot_cmd",
    "nav_status": "cmeresearch/cmexamini-001/navigation/status",
    "system_stats": "cmeresearch/cmexamini-001/system/stats",
    "robot_pose": "cmeresearch/cmexamini-001/base/robot_pose",
    "motor_feedback_prefix": "cmeresearch/cmexamini-001/base"
  },
  "drive_type": "diff",
  "docker_log_container": "cmexamini-hardware",
  "motor_feedback_wheels": ["front_right", "rear_left"],
  "limits": {
    "max_linear_x": 0.3,
    "max_linear_y": 0.0,
    "max_angular_z": 1.0
  },
  "velocities": {
    "forward": 0.2,
    "backward": -0.2,
    "left": 0.0,
    "right": 0.0,
    "rotate_cw": -0.5,
    "rotate_ccw": 0.5
  },
  "map": {
    "map_id": "cmexamini_house",
    "width": 20,
    "height": 20,
    "resolution": 0.05,
    "origin_x": -10.0,
    "origin_y": -10.0,
    "obstacles": []
  }
}
